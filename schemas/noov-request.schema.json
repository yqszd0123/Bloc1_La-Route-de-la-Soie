{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avelis.example/schemas/noov-wall-configuration-request.v2.json",
  "title": "Proposition de configuration Noov vers Bloc 1",
  "type": "object",
  "required": ["schema", "status", "project", "source", "geometry", "objective", "requestedOutputs"],
  "properties": {
    "schema": { "const": "avelis.noov.wall-configuration.request.v2" },
    "status": { "const": "INTERFACE_PROPOSAL_NOT_OFFICIAL_NOOV_FORMAT" },
    "geometry": {
      "type": "object",
      "required": ["wallLengthMm", "wallHeightMm", "wallThicknessMm", "placement", "openings"],
      "properties": {
        "wallLengthMm": { "type": "number", "exclusiveMinimum": 0 },
        "wallHeightMm": { "type": "number", "exclusiveMinimum": 0 },
        "wallThicknessMm": { "type": "number", "exclusiveMinimum": 0 },
        "openings": { "type": "array" }
      }
    },
    "objective": { "enum": ["balanced", "material", "manufacturing"] }
  }
}
