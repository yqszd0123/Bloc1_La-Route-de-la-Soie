{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avelis.example/schemas/logistics-wall-handover.v2.json",
  "title": "Proposition de remise Bloc 1 vers Bloc 3",
  "type": "object",
  "required": ["schema", "project", "candidateId", "componentIds", "calculatedSteelMassKg", "panelEnvelopeMm", "traceability", "requiredFromLogistics"],
  "properties": {
    "schema": { "const": "avelis.logistics.wall-handover.v2" },
    "candidateId": { "type": "string" },
    "componentIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "calculatedSteelMassKg": { "type": "number", "exclusiveMinimum": 0 },
    "panelEnvelopeMm": {
      "type": "object",
      "required": ["length", "height", "depth"],
      "properties": {
        "length": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "depth": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
